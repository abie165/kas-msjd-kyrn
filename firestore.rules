rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'jamaah';
    }
    function canManageKas() {
      return signedIn() && role() in ['bendahara', 'admin'];
    }
    function canManageTakmir() {
      return signedIn() && role() in ['takmir', 'bendahara', 'admin'];
    }

    // Jamaah boleh membaca informasi publik. Hanya akun dengan role
    // yang ditetapkan secara manual di Firebase Console yang boleh menulis.
    match /transactions/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageKas();
    }
    match /activities/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageTakmir();
    }
    match /pengurus/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageTakmir();
    }
    match /imam/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageTakmir();
    }
    match /santri/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageTakmir();
    }
    match /ustadz/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageTakmir();
    }
    match /bahan/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageTakmir();
    }

    // Profil peran dibaca oleh pemilik akun; perubahan role dilakukan
    // manual oleh admin melalui Firebase Console, bukan dari aplikasi.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Tutup semua koleksi lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
